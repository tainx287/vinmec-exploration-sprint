# =========================================================================
# MyVinmec Care Navigator Prototype - Configuration (.env)
# =========================================================================
# Prototype hỗ trợ đa nhà cung cấp LLM hoặc hoàn toàn offline mock-safe.
# Hệ thống tự động ưu tiên đọc file này, nếu thiếu sẽ tìm file .env tại thư mục gốc.

# 1. Agnes AI / OpenAI Compatible Endpoint
AGNES_API_KEY=sk-RCT7NnFJoIv9lovSF25sFA807XC5w3ob1ZKEdnNjtOjo82go
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# 2. OpenAI Trực Tiếp (nếu dùng OpenAI chính thức)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# 3. Google Gemini API (nếu dùng Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# 4. Cấu hình Model & Timeout
LLM_MODEL=gpt-4o-mini
REQUEST_TIMEOUT=15
